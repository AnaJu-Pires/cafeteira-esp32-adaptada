# placa: esp32 devkit 38 pinos com modulo esp32-wroom-32
# (chip esp32, cristal de 40 mhz, flash spi de 4 mb)
CONFIG_IDF_TARGET="esp32"

# flash do wroom-32: 4 mb, modo dio, 40 mhz
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# tabela de particoes padrao (app unica + nvs para o estoque)
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# console serial (usb do devkit) a 115200 baud
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# cpu a 240 mhz (maximo do esp32)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
